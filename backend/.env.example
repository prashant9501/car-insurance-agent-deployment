# ─── REQUIRED ──────────────────────────────────────────
OPENAI_API_KEY=sk-proj-PASTE-YOUR-KEY-HERE

# ─── Model (optional) ──────────────────────────────────
# gpt-4o / gpt-4o-mini shut down in the OpenAI API on 14 Jan 2027; gpt-6-luna replaces both.
# gpt-6-luna is a reasoning model: "none" keeps it fast. Leave the effort empty for
# models that are not reasoning models.
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

# ─── Optional ──────────────────────────────────────────
# Set this if you want LangSmith tracing (free at smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=car-insurance-agent
LANGSMITH_TRACING=false

# ─── App config ────────────────────────────────────────
CORS_ORIGINS=*
CHROMA_PERSIST_DIR=/app/chroma_db
LOG_LEVEL=INFO
